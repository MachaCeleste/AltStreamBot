<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Title>AltStreamBot</Title>
    <Version>0.1.4</Version>
    <Authors>Macha Celeste</Authors>
    <Company>Celestial Corp</Company>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Speech" Version="10.0.13" />
    <PackageReference Include="System.Windows.Extensions" Version="9.0.8" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AltStreamLib">
      <HintPath>..\..\AltStreamLib\AltStreamLib\bin\Debug\net9.0\AltStreamLib.dll</HintPath>
    </Reference>
    <Reference Include="SseClientLib">
      <HintPath>..\..\SseClientLib\SseClientLib\bin\Debug\net9.0\SseClientLib.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="Sounds\dialtone.wav">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Sounds\hangup.wav">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Sounds\pickup.wav">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Sounds\raid.wav">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Sounds\redeem.wav">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Sounds\ringer.wav">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="if &quot;$(Configuration)&quot;==&quot;Release&quot; call :Package&#xD;&#xA;goto :EOF&#xD;&#xA;&#xD;&#xA;:Package&#xD;&#xA;SET &quot;WINRAR_PATH=C:\Program Files\WinRAR\Rar.exe&quot;&#xD;&#xA;SET &quot;BUILD_ROOT=$(ProjectDir)..\Builds&quot;&#xD;&#xA;SET &quot;SOURCE_DIR=$(TargetDir)&quot;&#xD;&#xA;SET &quot;ARCHIVE_NAME=$(ProjectName)-v$(Version).rar&quot;&#xD;&#xA;if not exist &quot;%25BUILD_ROOT%25&quot; mkdir &quot;%25BUILD_ROOT%25&quot;&#xD;&#xA;&quot;%25WINRAR_PATH%25&quot; a -ep1 -r &quot;%25BUILD_ROOT%25\%25ARCHIVE_NAME%25&quot; &quot;%25SOURCE_DIR%25*&quot;&#xD;&#xA;" />
  </Target>

</Project>
